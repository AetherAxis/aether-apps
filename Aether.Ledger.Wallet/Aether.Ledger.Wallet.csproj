<Project Sdk="Microsoft.NET.Sdk">

  <!-- 链上钱包 CLI（自 monorepo apps/LedgerWallet 迁入，2026-10-27）：发币/查余额/转账/充值/提币不用写代码。
       定位 = 运维与用户操作面：国库分发、新人领币、交易所充值提币。
       withdraw 走交易所 JSON-RPC（17800，须登录）；其余直连链节点（17805）。
       出向依赖 = ① aether-ledger（账本客户端 + 桥）+ ④ aether-exchange.Rpc（提币的 RPC 客户端）——
       monorepo 版引的是 business/CtpExchange/Acme.Ctp.Sim，本仓用已拆的 ④（业务异常 CtpBusinessException
       → ExchangeBusinessException，ErrorId/ErrorMsg 同形）。
       远程服务器：交易所只绑回环——SSH 隧道 `ssh -L 17800:127.0.0.1:17800` 后本机可用。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\aether-ledger\src\Aether.Ledger\Aether.Ledger.csproj" />
    <ProjectReference Include="..\..\aether-exchange\src\Aether.Exchange.Rpc\Aether.Exchange.Rpc.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aether.Ledger.Wallet</AssemblyName>
    <RootNamespace>Aether.Ledger.Wallet</RootNamespace>
  </PropertyGroup>

</Project>
